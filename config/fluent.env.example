# Copy to .env and fill in your machine's values.
# These are used by PyFluent / Fluent, not by the MCP server itself (which uses
# FLUIDS_MCP_* variables). Set them in the shell that launches OpenCode/Claude.

# --- Ansys installation -------------------------------------------------
# Pick the version you actually have installed (v251 = 2025 R1, v261 = 2026 R1).
AWP_ROOT261=C:\Program Files\ANSYS Inc\v261
# AWP_ROOT251=C:\Program Files\ANSYS Inc\v251

# Optional: point directly at fluent.exe if auto-detection fails.
# FLUENT_EXE=C:\Program Files\ANSYS Inc\v261\fluent\ntbin\win64\fluent.exe

# --- License ------------------------------------------------------------
# Usually set by the Ansys installer. Example:
# ANSYSLMD_LICENSE_FILE=1055@license.example.com

# --- MCP server ---------------------------------------------------------
FLUIDS_MCP_LOG_LEVEL=INFO
FLUIDS_MCP_MAX_STEPS=30
# FLUIDS_MCP_DISABLE_SESSION_LOGS=1

# --- Safety -------------------------------------------------------------
# Do NOT enable unrestricted Python execution in untrusted sessions.
# PYFLUENT_MCP_ENABLE_PYTHON=1
