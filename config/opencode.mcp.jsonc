{
  // OpenCode V2 MCP configuration snippet.
  // Merge into ~/.config/opencode/opencode.json (note: mcp.servers, NOT mcp directly).
  // Replace <PACK_ROOT> with your absolute path to this pack. Use absolute paths;
  // ~ is not expanded here. install.ps1 -WithFluent writes this for you.
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "ansys-fluent": {
        "type": "local",
        "command": [
          "<PACK_ROOT>\\.venv\\Scripts\\ansys-fluent-mcp.exe"
        ],
        "environment": {
          "FLUIDS_MCP_LOG_LEVEL": "INFO",
          "FLUIDS_MCP_MAX_STEPS": "30"
        },
        "timeout": {
          "startup": 45000,
          "execution": 600000
        }
      }
    }
  }
}
